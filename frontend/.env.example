APP_NAME=Alignment Radar API
# "production" refuses to start unless JWT_SECRET_KEY and OTP_HMAC_SECRET are random values of 32+ characters
# and FRONTEND_ORIGINS lists explicit origins; it also disables /docs, /redoc and /openapi.json.
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","https://alingnment-radar.vercel.app","https://www.alingnment-radar.vercel.app"]
DATABASE_URL=sqlite+aiosqlite:///./alignment_radar.db
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_HMAC_SECRET=replace_with_a_separate_random_secret
# Optional: key for encrypting stored Google OAuth refresh tokens. Defaults to JWT_SECRET_KEY.
# Changing it (or JWT_SECRET_KEY while this is unset) makes existing stored Google connections unreadable.
ENCRYPTION_SECRET_KEY=
OTP_EXPIRE_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Email Delivery Provider ("brevo" | "resend" | "auto")
EMAIL_PROVIDER=brevo

# Brevo Transactional Email API (https://api.brevo.com/v3/smtp/email)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=your_verified_sender@domain.com
BREVO_FROM_NAME=Alignment Radar

# Resend Email API (Alternative/Fallback)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=your_verified_sender@domain.com

NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct
NVIDIA_TIMEOUT_SECONDS=60
# Voice notes (optional). Speech recognition and translation via NVIDIA NVCF; each falls back to NVIDIA_API_KEY,
# then to Groq. Audio is only sent when the sender has enabled AI processing in the app.
NVIDIA_ASR_API_KEY=
NVIDIA_TRANSLATION_API_KEY=

# Groq Cloud API (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30

# Nebius Token Factory (optional). Only used when AI_ROUTER_STRATEGY=nebius.
# Verify NEBIUS_MODEL against your account's model list before use.
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_TIMEOUT_SECONDS=30

# AI router strategy: "adaptive" | "nvidia" | "groq" | "nebius" | "local"
AI_ROUTER_STRATEGY=adaptive
AI_RACING_ENABLED=false
AI_CIRCUIT_BREAKER_FAILURES=3
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
AI_MIN_LATENCY_SAMPLES=3

YOUTUBE_DATA_API_KEY=your_youtube_api_key_here

SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

TAVILY_API_KEY=your_tavily_api_key_here

# Google OAuth & Identity (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

REDIS_URL=
AI_ANALYSIS_ENABLED=true
RECOMMENDATIONS_ENABLED=true
MAX_CONVERSATION_CONTEXT_MESSAGES=30
AI_COOLDOWN_SECONDS=30
LOG_LEVEL=INFO
