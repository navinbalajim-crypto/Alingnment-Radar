{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install --prefix frontend",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://alingnment-radar.onrender.com/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://alingnment-radar.onrender.com/socket.io/$1"
    },
    {
      "source": "/health",
      "destination": "https://alingnment-radar.onrender.com/health"
    },
    {
      "source": "/auth/google/callback",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/chat",
      "destination": "/index.html"
    },
    {
      "source": "/invitations/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/google8a6d50f5eedb5b8e.html",
      "destination": "/google8a6d50f5eedb5b8e.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
